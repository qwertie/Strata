Makes the test and bench sources that Visual Studio rejects (setenv, unsetenv, __builtin_popcount) compile, at
their paths before B1 (87d20a5c) and after it. run.ps1 applies each file's section where that file is, unless it is
applied already or the file no longer has those calls. No engine code.

diff --git a/bench/gdn_chunk_bench.cpp b/bench/gdn_chunk_bench.cpp
index 22f7d3d5..f39ec582 100644
--- a/bench/gdn_chunk_bench.cpp
+++ b/bench/gdn_chunk_bench.cpp
@@ -39,6 +39,11 @@ struct Rng {
 float timed(const char* mode, const char* warp, float* st, float* st0, float* h, float* g, float* b, float* z,
             float* ga, float* y, uint16_t* y16, int64_t T, int iters) {
+#if defined(_WIN32)
+    _putenv_s("STRATA_GDN_CHUNK", mode);
+    _putenv_s("STRATA_GDN_REC_WARP", warp);
+#else
     setenv("STRATA_GDN_CHUNK", mode, 1);
     setenv("STRATA_GDN_REC_WARP", warp, 1);
+#endif
     cudaEvent_t e0, e1;
     check(cudaEventCreate(&e0), "event");
diff --git a/src/kernels/cpu/native_hadamard_test.cpp b/src/kernels/cpu/native_hadamard_test.cpp
index 2b8012e5..503cceb8 100644
--- a/src/kernels/cpu/native_hadamard_test.cpp
+++ b/src/kernels/cpu/native_hadamard_test.cpp
@@ -29,4 +29,5 @@
 #include <cstring>
 #include <algorithm>
+#include <bit>
 #include <random>
 #include <string>
@@ -284,5 +285,5 @@ int fwht_check() {
     for (int r = 0; r < B; ++r) {
         double acc = 0;
-        for (int c = 0; c < B; ++c) acc += ((__builtin_popcount(r & c) & 1) ? -1.0 : 1.0) * s[c] * x[c];
+        for (int c = 0; c < B; ++c) acc += ((std::popcount(unsigned(r & c)) & 1) ? -1.0 : 1.0) * s[c] * x[c];
         worst = std::max(worst, std::fabs(acc / std::sqrt((double) B) - y[r]));
     }
diff --git a/src/kernels/gdn_chunk_parity.cpp b/src/kernels/gdn_chunk_parity.cpp
index 2a271694..723e19ce 100644
--- a/src/kernels/gdn_chunk_parity.cpp
+++ b/src/kernels/gdn_chunk_parity.cpp
@@ -184,6 +184,11 @@ void run_case(int64_t T, uint64_t seed) {
     auto run = [&](const char* chunk, const char* warp, std::vector<float>& y, std::vector<float>& st,
                    std::vector<float>* y16f = nullptr) {
+#if defined(_WIN32)
+        _putenv_s("STRATA_GDN_CHUNK", chunk);
+        _putenv_s("STRATA_GDN_REC_WARP", warp);
+#else
         setenv("STRATA_GDN_CHUNK", chunk, 1);
         setenv("STRATA_GDN_REC_WARP", warp, 1);
+#endif
         check(cudaMemcpy(d_st, d_st0, st0.size() * 4, cudaMemcpyDeviceToDevice), "D2D");
         strata::prefill::gdn_recurrence(d_st, d_h, d_g, d_b, d_z, d_ga, eps, d_y, d_y16, T, nullptr);
diff --git a/src/kernels/hc_persist_parity.cpp b/src/kernels/hc_persist_parity.cpp
index 0e630060..4597758e 100644
--- a/src/kernels/hc_persist_parity.cpp
+++ b/src/kernels/hc_persist_parity.cpp
@@ -53,6 +53,10 @@ T* dev(size_t n) {
 int main(int argc, char** argv) {
     const bool off = argc > 1 && std::strcmp(argv[1], "--off") == 0;
+#if defined(_WIN32)
+    _putenv_s("STRATA_HC_PERSIST", off ? "" : "1");   // an empty value removes the variable
+#else
     if (off) unsetenv("STRATA_HC_PERSIST");
     else setenv("STRATA_HC_PERSIST", "1", 1);
+#endif
     k::fused_gr_check();
     k::fused_gr_persist_init();
